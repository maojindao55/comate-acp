{
  "name": "comate-acp",
  "version": "0.1.3",
  "description": "Agent Client Protocol adapter that exposes the Baidu Comate (Zulu) CLI as an ACP agent",
  "main": "dist/index.js",
  "bin": {
    "comate-acp": "./dist/index.js"
  },
  "type": "module",
  "files": [
    "dist",
    "README.md"
  ],
  "keywords": [
    "comate",
    "baidu-comate",
    "acp",
    "agent-client-protocol",
    "zulu",
    "ai-agent",
    "streaming"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maojindao55/comate-acp.git"
  },
  "author": "maojindao55 <hobby0524@gmail.com>",
  "bugs": {
    "url": "https://github.com/maojindao55/comate-acp/issues"
  },
  "homepage": "https://github.com/maojindao55/comate-acp#readme",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20.10"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run build",
    "test": "node --test test/*.test.mjs",
    "prepare": "npm run build",
    "start": "node dist/index.js",
    "dev": "tsc -w",
    "release": "node scripts/release.js",
    "release:patch": "node scripts/release.js patch",
    "release:minor": "node scripts/release.js minor",
    "release:major": "node scripts/release.js major"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.5.0"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^1.3.0",
    "jsonc-parser": "^3.3.1"
  }
}
